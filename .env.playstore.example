# Play Store build configuration for Siti AI (Android).
#
# No credential or personal path is committed. Copy this file to an untracked
# `.env.playstore`, fill in the real value, and scripts/build-android.sh
# auto-loads it:
#
#   cp .env.playstore.example .env.playstore   # then edit
#   make psmobile
#
# This is the Android counterpart to .env.appstore (macOS / iOS / visionOS).
# Root .gitignore ignores `.env.*`, so the filled-in copy stays untracked.

# ── Signing (make psmobile) ────────────────────────────────────────────────
# Absolute path to the upload keystore (.jks). Required — the build aborts
# without it.
#
# This is the only way to point the build at a keystore: the `keystore` step
# rewrites `storeFile=` in src-tauri/gen/android/keystore.properties from this
# value on every run, so editing that file by hand has no effect.
#
# The matching `password` and `keyAlias` live in
# src-tauri/gen-override/android/keystore.properties — copy the .example beside
# it and fill those in once. Neither file is committed.
#
# An inline override still wins over this file, for a one-off build against a
# different keystore:
#
#   KEYSTORE_PATH=/other/upload.jks make psmobile
KEYSTORE_PATH=/absolute/path/to/your/upload-keystore.jks
