# App Store build configuration for Siti AI (macOS + iOS).
#
# No account, credential, or signing detail is committed. Copy this file to an
# untracked `.env.appstore`, fill in the real values, and the build scripts
# auto-load it:
#
#   cp .env.appstore.example .env.appstore   # then edit
#   make asmacos        # or: make asios
#
# Find values with:
#   security find-identity -v -p codesigning      # signing identities
#   App Store Connect → Users & Access → Integrations → App Store Connect API

# ── macOS (make asmacos) ───────────────────────────────────────────────────
# Installer cert ("3rd Party Mac Developer Installer: …" or its SHA-1).
# NOTE: this is the *Installer* cert used by productbuild — distinct from the
# app codesigning identity in tauri.prod-macos-appstore.conf.json.
SIGNING_IDENTITY=

# ── iOS (make asios) ───────────────────────────────────────────────────────
# Distribution identity used by the fixplist re-sign, required only when the
# build machine is on a beta macOS/Xcode toolchain (see scripts/build-ios.sh
# `fixplist` step). ("Apple Distribution: …" or its SHA-1 fingerprint.)
SIGN_IDENTITY=

# ── Optional overrides (committed defaults exist in the scripts) ───────────
# ASC_API_KEY=
# ASC_ISSUER_ID=
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# RELEASE_OS_BUILD=25A354
