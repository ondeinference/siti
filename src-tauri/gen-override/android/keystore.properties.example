# Android upload-keystore config for release (.aab) signing.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in
# `password` and `keyAlias`.
#
# Leave `storeFile` as-is: scripts/build-android.sh rewrites that line on every
# run from KEYSTORE_PATH, so a hand-edited value here is always discarded. Set
# the keystore location in .env.playstore instead (see .env.playstore.example).
#
# NEVER commit the real keystore.properties or the .jks file.

password=CHANGE_ME
keyAlias=upload
# Overwritten by scripts/build-android.sh from KEYSTORE_PATH — see above.
storeFile=/absolute/path/to/your/upload-keystore.jks
