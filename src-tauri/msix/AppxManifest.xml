<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store submission.

  Tauri only bundles .msi/.exe, and a Store MSI/EXE submission is nothing but
  a hosted installer URL — the Store never licenses those, so they get no
  package identity and Windows.Services.Store add-ons cannot work from them.
  This manifest wraps the same built .exe as a full-trust MSIX, which is what
  gives the app the Store identity that StoreContext needs.

  __IDENTITY_NAME__, __PUBLISHER__ and __VERSION__ are placeholders filled in
  by scripts/build-msix.ps1. Name and Publisher must match the values Partner
  Center shows under Product identity for this app, character for character,
  or the Store rejects the upload.

  Siti AI is developed by PT Sigit Mitra Bangun and published by Splitfire AB
  (see NOTICE), so Publisher (CN=...) and PublisherDisplayName come from the
  same Partner Center account as the other Splitfire AB apps. Only the
  Identity Name below is unique to Siti AI's product.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Siti AI</DisplayName>
    <!--
      PublisherDisplayName must match the account's registered publisher
      display name in Partner Center EXACTLY, or upload is rejected at
      acceptance validation (not at makeappx time).
    -->
    <PublisherDisplayName>Splitfire AB Developer</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SitiAI" Executable="Siti AI.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Siti AI"
        Description="Private, on-device AI assistant."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
