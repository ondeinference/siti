# Android upload-keystore config for release (.aab) signing.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in your
# own values, or export KEYSTORE_PATH before running scripts/build-android.sh —
# the script patches `storeFile` at build time.
#
# NEVER commit the real keystore.properties or the .jks file.

password=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/your/upload-keystore.jks
